# --- Core ---
DATABASE_URL="postgresql://app:app@localhost:5432/cosmic"
# Long random string: openssl rand -hex 32
AUTH_SECRET=""
# Public URL of the site, no trailing slash (used for WayForPay and Telegram callbacks)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Emails that become admins on registration/login, comma-separated
ADMIN_EMAILS=""

# --- WayForPay (Merchant account → Settings) ---
WAYFORPAY_MERCHANT_ACCOUNT=""
WAYFORPAY_SECRET_KEY=""
# Domain registered in WayForPay (defaults to the host of NEXT_PUBLIC_SITE_URL)
WAYFORPAY_DOMAIN=""

# --- Telegram admin bot (@BotFather) ---
TELEGRAM_BOT_TOKEN=""
# Telegram user ids of admins, comma-separated (the bot shows your id when you write /start)
TELEGRAM_ADMIN_IDS=""
# Random string, protects the webhook: openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=""

# --- AI assistant (console.anthropic.com) ---
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5-5"

# --- Content ---
NEXT_PUBLIC_TRIAL_URL="https://winwinpro.customer.smartsender.eu/lp/spKmw9bA?ref=248654060"
NEXT_PUBLIC_MENTOR_TELEGRAM=""
NEXT_PUBLIC_MENTOR_INSTAGRAM=""
# Seller details for the public offer (ФОП name, tax id, address, email)
NEXT_PUBLIC_SELLER_DETAILS=""
